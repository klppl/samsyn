{
  "name": "replica",
  "version": "0.1.0",
  "description": "Conflict-free live sync for Obsidian vaults (CRDT, self-hosted)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "node --test --import tsx tests/*.test.ts"
  },
  "keywords": [
    "obsidian",
    "sync",
    "crdt",
    "yjs"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "obsidian": "^1.8.7",
    "tslib": "^2.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "lib0": "^0.2.100",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.6",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.20"
  }
}
